#!/usr/bin/env bash
# pre-push hook: 推送 main/dev 分支前运行 typecheck + build 检查

remote="$1"
current_branch=$(git symbolic-ref --short HEAD 2>/dev/null)

# 只检查 main 和 dev 分支
if [[ "$current_branch" != "main" && "$current_branch" != "dev" ]]; then
  exit 0
fi

echo "🔍 [pre-push] 分支 $current_branch → 运行构建检查..."

echo "  → typecheck"
make typecheck || { echo "❌ typecheck 失败，推送中止"; exit 1; }

echo "  → build"
make build || { echo "❌ build 失败，推送中止"; exit 1; }

echo "✅ [pre-push] 构建检查通过"
