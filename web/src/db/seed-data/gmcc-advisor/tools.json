[
  {
    "name": "route_loan_products",
    "description": "根据借款人的收入类型（Income Type）和房产所在州（Property State）路由匹配的贷款产品。返回所有匹配产品的名称及其完整核保标准，供后续逐项核查使用。",
    "parameters": [
      {
        "id": "rlp-1",
        "name": "income_type",
        "type": "enum",
        "description": "借款人的收入类型",
        "required": true,
        "enumRef": "income_type_enum"
      },
      {
        "id": "rlp-2",
        "name": "property_state",
        "type": "enum",
        "description": "房产所在州的缩写",
        "required": true,
        "enumRef": "state_enum"
      }
    ],
    "handler": "async ({ income_type, property_state }, context) => {\n  const routes = await context.dataset.getEntries(\"product_routes\");\n  const state = property_state.toUpperCase().trim();\n  const income = income_type.trim();\n  const matched = [];\n  for (const r of routes) {\n    const incomes = r.metadata?.incomes;\n    const states = r.metadata?.states;\n    if (!Array.isArray(incomes) || !Array.isArray(states)) continue;\n    if (incomes.includes(income) && states.includes(state)) matched.push(r);\n  }\n  if (matched.length === 0) {\n    return { income_type: income, property_state: state, matched_count: 0, products: [], message: `未找到匹配的产品。收入类型 \"${income}\" 在州 \"${state}\" 下没有可用产品。` };\n  }\n  const products = await Promise.all(matched.map(async (r) => { const doc = await context.wiki.get(r.metadata.wikiId); return { product_name: r.label || r.value, content: doc?.content || `未找到 ${r.metadata.wikiId} 的核保文档` }; }));\n  return { income_type: income, property_state: state, matched_count: products.length, products, message: `找到 ${products.length} 个匹配产品，请根据以下各产品核保标准继续收集剩余信息并逐项核查。` };\n}",
    "enabled": true
  },
  {
