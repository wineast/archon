{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port $(node -p \"try{require('../.worktree/meta.json').dev}catch{3000}\")",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev --no-open -p $(node -p \"try{require('../.worktree/meta.json').storybook}catch{6006}\")",
    "build-storybook": "storybook build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "tsx src/db/ensure-extensions.ts && drizzle-kit push && tsx src/db/ensure-extensions.ts",
    "db:reset": "tsx src/db/reset.ts && tsx src/db/ensure-extensions.ts && drizzle-kit push --force && tsx src/db/ensure-extensions.ts && tsx src/db/seed.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "vercel-build": "npm run db:migrate && npm run db:seed && next build"
  },
